# O que NAO vai para o EAS Build (app mobile). Com este arquivo, o EAS deixa de ler o .gitignore:
# por isso ele repete tudo o que ja e ignorado, mais o que so serve ao desenvolvimento.

# dependencias e builds (o EAS instala de novo)
node_modules/
.pnpm-store/
dist/
.next/
out/
coverage/
*.tsbuildinfo
*.log

# segredos: nunca saem da maquina
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# backups do banco
infra/backups/
*.archive
*.gz.enc

# app mobile: pastas geradas (CNG)
.expo/
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/

# capacitor (sai na etapa 5)
apps/web/ios/
apps/web/android/

# ferramentas do editor e do agente (tem atalhos que o Windows nao deixa copiar)
.claude/
.agents/
.vscode/
.idea/
.DS_Store
Thumbs.db
