{
  "name": "@pluto/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx --env-file=.env src/db/setup.ts",
    "pluggy:check": "tsx --env-file=.env scripts/pluggy-check.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "user:set-cpf": "tsx --env-file=.env scripts/set-cpf.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@pluto/finance-engine": "workspace:^",
    "@pluto/shared": "workspace:^",
    "@simplewebauthn/server": "^13",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "pluggy-sdk": "^0.92.0",
    "stripe": "^23.0.0",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "3.6.4",
    "mongodb-memory-server": "^11.3.0",
    "qrcode": "^1.5.4",
    "tsup": "^8",
    "tsx": "^4.23.15"
  }
}
