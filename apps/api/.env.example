# Copie para apps/api/.env e preencha. Nunca faça commit do .env.
# Segredos (JWT, FIELD_ENCRYPTION_KEY, BACKUP_PASSPHRASE, VAPID): node apps/api/scripts/gen-secrets.mjs

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# MongoDB (Atlas ou local). O banco vem de MONGODB_DB, não da URI.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pluto

# Sessão (Ed25519, base64) e criptografia de campos (32 bytes, base64)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
FIELD_ENCRYPTION_KEY=

# Origens do site (separadas por vírgula; nunca "*")
ALLOWED_ORIGINS=http://localhost:3000

# Open Finance (Pluggy)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Passkeys: domínio (padrão: host da primeira origem)
WEBAUTHN_RP_ID=

# IA (Gemini): só explica e conversa; os cálculos são do motor financeiro
GEMINI_API_KEY=
LLM_MODEL=

# Boletos (Stripe): use a chave de TESTE fora de produção (rk_test_... / sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Notificações (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Monitoramento (opcional)
SENTRY_DSN=

# Backup cifrado (obrigatório em produção)
BACKUP_PASSPHRASE=

SYNC_INTERVAL_HOURS=6
