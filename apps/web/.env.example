# Somente variaveis publicas aqui. Nenhum segredo no bundle do app (secao 6.1).

# Web: deixe vazio. O site chama /v1 e o Next repassa para a API (API_PROXY_TARGET).
# Mobile (build estatico): endereco da API pela VPN/rede, ex.: https://pluto.seu-tailnet.ts.net/v1
NEXT_PUBLIC_API_URL=

# Para onde o Next repassa /v1 no modo web (servidor, nao vai para o navegador).
API_PROXY_TARGET=http://127.0.0.1:3333
