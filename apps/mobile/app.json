{
  "expo": {
    "name": "Pluto",
    "slug": "pluto-mobile",
    "scheme": "pluto",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F8",
    "ios": {
      "bundleIdentifier": "br.pessoal.pluto",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.pessoal.pluto",
      "adaptiveIcon": {
        "backgroundColor": "#EFE6FD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use o Face ID para desbloquear o Pluto."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para desbloquear o Pluto."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFE6FD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f5cf02c2-01cd-47de-a605-c954d6821ab0"
      }
    },
    "owner": "br.pessoal.pluto"
  }
}
