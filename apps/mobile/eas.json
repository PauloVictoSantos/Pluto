{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.13.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pluto-sfou.onrender.com",
        "MONGOMS_DISABLE_POSTINSTALL": "1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}
